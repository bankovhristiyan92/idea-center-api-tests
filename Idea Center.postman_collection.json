    {
      "name": "User Authentication",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\npm.test(\"Response has required attributes\", function () {\r\n    var jsonData = pm.response.json();\r\n    pm.expect(jsonData).to.have.property('email');\r\n    pm.expect(jsonData).to.have.property('password');\r\n    pm.expect(jsonData).to.have.property('accessToken');\r\n    // Запазване на токена в колекционна променлива\r\n    pm.collectionVariables.set(\"token\", jsonData.accessToken);\r\n});"
            ]
          }
        }
      ],
